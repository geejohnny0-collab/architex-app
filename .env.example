# ═══════════════════════════════════════════════════════════════
# Architex — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────
# Local dev: file:./dev.db (SQLite)
# Production (Neon): postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="file:./dev.db"

# ─── Authentication ───────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_64_CHAR_RANDOM_STRING"
JWT_EXPIRES_IN="7d"

# ─── Google OAuth ─────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-secret"

# ─── Cloudinary ───────────────────────────────────────────────
# Free account at cloudinary.com — Dashboard → copy these 3 values
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── App Config ───────────────────────────────────────────────
PORT=5000
NODE_ENV="development"

# Production: set this to your Vercel frontend URL
# e.g. https://architex.vercel.app
FRONTEND_URL="http://localhost:5176"

# ─── Frontend (Vite) ──────────────────────────────────────────
# Production: set this to your Render backend URL
# e.g. https://architex-api.onrender.com
VITE_API_URL="http://localhost:5000"
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
